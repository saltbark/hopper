// hopper-relay.saltbark.com: pipes sealed messages between Hopper on the Mac and on the phone.
// `pnpm relay:dev` runs it on localhost:8787; `pnpm relay:deploy` ships it (by hand, for now).
{
  "name": "hopper-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "routes": [{ "pattern": "hopper-relay.saltbark.com", "custom_domain": true }],
  "workers_dev": false,
}
