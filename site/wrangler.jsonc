// hopper.saltbark.com: the landing page, static files only. `pnpm site:deploy` builds and ships it;
// the release workflow runs it after every release.
{
  "name": "hopper-site",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "hopper.saltbark.com", "custom_domain": true }],
  "workers_dev": false,
}
